# Salin menjadi .env untuk lokal. Di Vercel isi lewat Project Settings > Environment Variables.
# JANGAN commit .env. Semua variabel di bawah opsional kecuali SMTP (untuk OTP).

# Kosong = auth API mati (mode demo). Isi string acak panjang untuk mengaktifkan.
GATEWAY_SECRET=
NAMA_TOKO=SATRIA REAL MARKET
WA_ORDER=
TG_ADMIN=
QRIS_IMAGE=
MUSIC_URL=

DEV_USERNAME=
DEV_EMAIL=
DEV_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SatriaReal <email@contoh.com>"

OTP_EXPIRY_MIN=5
OTP_LENGTH=6

# Fitur baru (semua opsional; tanpa key app tetap jalan dengan mock)
